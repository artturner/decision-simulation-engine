# Copy to .env (same folder — .env is gitignored) and fill in the secrets.
# Everything not set here falls back to the defaults in export_all_grades.py.

# Teacher login for scenarios.cruxlabs.academy / essays.cruxlabs.academy
# (both use the same Supabase account).
SUPABASE_TEACHER_EMAIL=
SUPABASE_TEACHER_PASSWORD=

# Teacher login for videos.cruxlabs.academy. Leave blank to reuse
# TEACHER_EMAIL / TEACHER_PASSWORD from the video-quiz repo's .env:
VIDEO_TEACHER_EMAIL=
VIDEO_TEACHER_PASSWORD=
# VIDEO_QUIZ_ENV=C:\Users\arttu\video-quiz\.env

# Old/test students still on an app class roll — skip silently, never warn:
# IGNORE_STUDENTS=First Last; First Last

# Where the dated all_grades_import CSVs land:
# OUT_DIR=C:\Users\arttu\OneDrive - Grand Prairie ISD\2026 Fall\grade-imports
